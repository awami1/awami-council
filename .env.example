# Database (MySQL — production on DigitalOcean)
# Leave empty to use SQLite (local development)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=25060
# SSL certificate path for managed databases (DigitalOcean)
# Download from your database dashboard → "Download CA certificate"
DB_SSL_CA=

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

# Set to "true" to disable /api/setup.php in production
SETUP_DISABLED=false
