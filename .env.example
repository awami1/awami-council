# Database (MySQL — production on CranL / DigitalOcean)
# Leave empty to use SQLite (local development)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

# CranL/DigitalOcean also sets lowercase vars: host, database, username, password, port
# Both naming conventions are supported automatically

# SSL mode for DigitalOcean Managed MySQL
# Set to REQUIRED for DigitalOcean managed databases (port 25060)
sslmode=
# Optional: path to CA certificate file (SSL works without it using unverified mode)
# DB_SSL_CA=ca-certificate.crt

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

# Set to "true" to disable /api/setup.php in production
SETUP_DISABLED=false
